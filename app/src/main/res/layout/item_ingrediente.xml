<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila del detalle: nombre del ingrediente, su porcentaje y una barra -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_nombre_ingrediente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/texto_principal"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txt_porcentaje_ingrediente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barra_ingrediente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100"
        app:indicatorColor="@color/verde_principal"
        app:indicatorTrackGapSize="0dp"
        app:trackColor="@color/verde_claro"
        app:trackStopIndicatorSize="0dp"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
</LinearLayout>
