        <item name="colorPrimary">@color/verde_principal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/verde_claro</item>
        <item name="colorOnPrimaryContainer">@color/verde_oscuro</item>
        <item name="colorSecondaryContainer">@color/verde_claro</item>
        <item name="colorOnSecondaryContainer">@color/verde_oscuro</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnBackground">@color/texto_principal</item>
        <item name="colorOnSurface">@color/texto_principal</item>
